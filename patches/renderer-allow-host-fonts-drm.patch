 #include <AK/LexicalPath.h>
+#include <LibCore/Directory.h>
+#include <LibCore/StandardPaths.h>
 #include <LibCore/System.h>
 #include <LibSandbox/Sandbox.h>
 #include <LibSandbox/Seccomp.h>
@@ -29,6 +31,18 @@ ErrorOr<void> apply_sandbox(StringView)
     TRY(Sandbox::add_loaded_library_directories(paths, build_root));
     TRY(Sandbox::add_landlock_path_if_exists(paths, "/proc/self"sv, Sandbox::LandlockPath::Access::ReadOnly));
 
+    // fontconfig's configuration and the DRM device database are the host's; an AppImage carries
+    // neither of them.
+    TRY(Sandbox::add_landlock_path_if_exists(paths, "/etc/fonts"sv, Sandbox::LandlockPath::Access::ReadOnly));
+    TRY(Sandbox::add_landlock_path_if_exists(paths, "/usr/share/libdrm"sv, Sandbox::LandlockPath::Access::ReadOnly));
+    TRY(Sandbox::add_landlock_path_if_exists(paths, "/usr/local/share/libdrm"sv, Sandbox::LandlockPath::Access::ReadOnly));
+
+    // fontconfig builds the font catalog cache in this process, so give it a directory it can write
+    // before the sandbox goes on. It then neither creates nor chmods it.
+    auto fontconfig_cache_path = LexicalPath::join(Core::StandardPaths::cache_directory(), "fontconfig"sv).string();
+    TRY(Core::Directory::create(fontconfig_cache_path, Core::Directory::CreateDirectories::Yes, 0755));
+    TRY(Sandbox::add_landlock_path_if_exists(paths, fontconfig_cache_path, Sandbox::LandlockPath::Access::ReadWrite));
+
     TRY(Sandbox::restrict_filesystem_with_landlock(paths.span()));
 
     Sandbox::SeccompPolicy policy;
