diff --git a/Libraries/LibSandbox/Seccomp.cpp b/Libraries/LibSandbox/Seccomp.cpp
index a435f93..876a532 100644
--- a/Libraries/LibSandbox/Seccomp.cpp
+++ b/Libraries/LibSandbox/Seccomp.cpp
@@ -1463,6 +1463,14 @@ void SeccompPolicy::allow_ipc()
     // LibIPC's Rust transports shut their socket down when they stop, so the peer sees them go at once.
     SECCOMP_APPEND_ALLOW_SYSCALL_IF_DEFINED(*this, shutdown);
     SECCOMP_APPEND_ALLOW_SYSCALL_IF_DEFINED(*this, eventfd2);
+    // fontconfig chmods its cache directory and the cache files that it writes. Landlock still
+    // decides which paths it can reach.
+    SECCOMP_APPEND_ALLOW_SYSCALL(*this, chmod);
+    SECCOMP_APPEND_ALLOW_SYSCALL(*this, fchmod);
+    // LibCore's file watcher uses inotify.
+    SECCOMP_APPEND_ALLOW_SYSCALL(*this, inotify_init1);
+    SECCOMP_APPEND_ALLOW_SYSCALL(*this, inotify_add_watch);
+    SECCOMP_APPEND_ALLOW_SYSCALL(*this, inotify_rm_watch);
     SECCOMP_APPEND_ALLOW_SYSCALL_IF_DEFINED(*this, poll);
     SECCOMP_APPEND_ALLOW_SYSCALL_IF_DEFINED(*this, ppoll);
     SECCOMP_APPEND_ALLOW_SYSCALL_IF_DEFINED(*this, pselect6);
